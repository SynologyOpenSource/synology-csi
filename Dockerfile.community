# Copyright 2026 Synology Inc.

############## Build stage ##############
FROM --platform=$BUILDPLATFORM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS builder
LABEL stage=synobuilder-community

RUN apk add --no-cache make
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY Makefile main.go ./
COPY pkg ./pkg
ARG TARGETARCH
ARG TARGETVARIANT
RUN if [ "$TARGETARCH" = arm ]; then export GOARM="${TARGETVARIANT#v}"; fi \
    && GOARCH="$TARGETARCH" make bin/synology-csi-driver

############## Final stage ##############
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289

ARG IMAGE_VERSION=dev
ARG IMAGE_RELEASE=1
LABEL name="synology-csi" \
      maintainer="Synology" \
      vendor="Synology Inc." \
      version="${IMAGE_VERSION}" \
      release="${IMAGE_RELEASE}" \
      summary="Synology CSI driver for Kubernetes" \
      description="A Container Storage Interface (CSI) driver for Synology NAS."

# Keep the UBI image's filesystem, mount, network, and NVMe runtime package
# contract using public Ubuntu packages. Ubuntu coreutils provides the exact
# /usr/sbin/chroot path used by hostexec for the privileged node plugin.
# The shipped node manifests set --chroot-dir=/host, so iscsiadm and multipath
# commands run from the host; filesystem formatting and mount helpers run here.
# Retain nvme-cli to match the existing UBI runtime package set.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        cifs-utils \
        coreutils \
        e2fsprogs \
        iproute2 \
        mount \
        nfs-common \
        nvme-cli \
        util-linux \
        xfsprogs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /

COPY LICENSE /licenses/LICENSE
COPY --from=builder /src/bin/synology-csi-driver /synology-csi-driver

# Run the controller as a non-root user by default. The node DaemonSet uses
# runAsUser: 0 so it can mount volumes and execute host tools.
USER 1000

ENTRYPOINT ["/synology-csi-driver"]
